<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import com.example.codexnaturalis.PlayerDeckController?>
<?import com.example.codexnaturalis.StructLeftController?>
<?import com.example.codexnaturalis.CardDrawableController?>
<?import com.example.codexnaturalis.StructRightController?>

<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>

<?import javafx.scene.text.Text?>
<?import com.example.codexnaturalis.TabelloneController?>
<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.example.codexnaturalis.MainController"
         minWidth="1440.0" maxWidth="1440.0" maxHeight="810.0" minHeight="810.0"
         tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text = "Giocatore 1">
            <content>
                <BorderPane xmlns="http://javafx.com/javafx"
                            xmlns:fx="http://javafx.com/fxml"
                            minWidth="1440.0" maxWidth="1440.0" maxHeight="810.0" minHeight="810.0">
                    <bottom>
                        <PlayerDeckController fx:id="playerDeck"  />
                    </bottom>
                    <top >
                        <HBox >
                            <StructRightController fx:id="struct"  maxHeight="60.0"/>
                            <CardDrawableController fx:id="cardDrawable" />
                        </HBox>
                    </top>

                </BorderPane>
            </content>
        </Tab>
        <Tab text = "Giocatore 2">
            <content>
                <HBox >
                    <StructRightController fx:id="struct2" />
                </HBox>
            </content>
        </Tab>
        <Tab text = "Giocatore 3">
            <content>
                <Pane >
                    <StructRightController fx:id="struct3" />
                </Pane>
            </content>
        </Tab>
        <Tab text = "Giocatore 4">
            <content>
                <HBox >
                    <StructRightController fx:id="struct4" />
                </HBox>
            </content>
        </Tab>
        <Tab text = "Tabellone">
            <content>
                <Pane >
                    <TabelloneController fx:id="table" />
                </Pane>
            </content>
        </Tab>
    </tabs>
</TabPane>



