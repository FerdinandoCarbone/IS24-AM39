<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import com.example.codexnaturalis.PlayerDeckController?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>

<?import com.example.codexnaturalis.FieldController?>
<?import com.example.codexnaturalis.CardController?>
<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.example.codexnaturalis.MainController"
         minWidth="1040.0" maxWidth="700" maxHeight="1040" minHeight="700"
         fx:id="tabContainer">
        <Tab text="Your playing Field:" closable="false">
            <BorderPane>
                <left>
                    <VBox>
                        <ScrollPane prefWidth="1200" prefHeight="750" fx:id="fieldScrollPane">
                            <FieldController fx:id="field"/>
                        </ScrollPane>
                        <HBox>
                            <PlayerDeckController fx:id="playerDeck"/>
                            <HBox>
                                <CardController fx:id="secretObjCard"/>
                                <VBox>
                                    <CardController fx:id="publicObj1"/>
                                    <CardController fx:id="publicObj2"/>
                                </VBox>
                            </HBox>
                        </HBox>
                    </VBox>
                </left>
                <right>
                    <BorderPane>
                        <top>
                            <VBox>
                                <HBox fx:id="rightTopPart"/>
                            </VBox>
                        </top>
                        <bottom>
                            <VBox fx:id="vbox">
                                <HBox fx:id="turnBOX" spacing="15">
                                    <TextField fx:id="textField" promptText="Enter your chat text here"/>
                                    <Button fx:id="sendButton" text="Send" mnemonicParsing="false" style="-fx-cursor: hand"
                                            onAction="#chatWrite"/>
                                </HBox>
                            </VBox>
                        </bottom>
                    </BorderPane>
                </right>
            </BorderPane>
        </Tab>
        <Tab fx:id="tab1" disable="true" text="Player 2">
            <ScrollPane prefWidth="1200" prefHeight="750">
                <FieldController fx:id="field2"/>
            </ScrollPane>
        </Tab>
        <Tab fx:id="tab2" disable="true" text="Player 3">
            <ScrollPane prefWidth="1200" prefHeight="750">
                <FieldController fx:id="field3"/>
            </ScrollPane>
        </Tab>
        <Tab fx:id="tab3" disable="true" text="Player 4">
            <ScrollPane prefWidth="1200" prefHeight="750">
                <FieldController fx:id="field4"/>
            </ScrollPane>
        </Tab>
</TabPane>