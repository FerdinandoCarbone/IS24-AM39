<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import com.example.codexnaturalis.PlayerDeckController?>
<?import com.example.codexnaturalis.StructLeftController?>

<?import com.example.codexnaturalis.StructRightController?>
<?import com.example.codexnaturalis.CommandBoxController?>
<?import javafx.scene.control.ScrollBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.TextFlow?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import com.example.codexnaturalis.TabelloneController?>

<?import com.example.codexnaturalis.FieldController?>
<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.example.codexnaturalis.MainController"
         minWidth="1040.0" maxWidth="700" maxHeight="1040" minHeight="700">
        <Tab text="Your playing Field:">
            <BorderPane>
                <left>
                    <ScrollPane prefWidth="1000" prefHeight="800" fx:id="fieldScrollPane">
                        <FieldController fx:id="field"/>
                    </ScrollPane>
                </left>
                <right>
                    <AnchorPane>
                        <VBox fx:id="vbox" alignment="CENTER">
                            <CommandBoxController fx:id="commands" AnchorPane.topAnchor="100"
                                                  AnchorPane.rightAnchor="10"/>
                            <PlayerDeckController fx:id="playerDeck"/>
                            <HBox fx:id="turnBOX" spacing="15">
                                <TextField fx:id="textField" promptText="Enter your chat text here"/>
                                <Button fx:id="sendButton" text="Send" mnemonicParsing="false" style="-fx-cursor: hand"
                                        onAction="#chatWrite"/>
                            </HBox>

                        </VBox>
                    </AnchorPane>
                </right>
            </BorderPane>
        </Tab>
        <Tab fx:id="tab1" disable="true" text="Player 2">
            <HBox>
                <FieldController fx:id="field2"/>
            </HBox>
        </Tab>
        <Tab fx:id="tab2" disable="true" text="Player 3">
            <Pane>
                <FieldController fx:id="field3"/>
            </Pane>
        </Tab>
        <Tab fx:id="tab3" disable="true" text="Player 4">
            <HBox>
                <FieldController fx:id="field4"/>
            </HBox>
        </Tab>
        <Tab text="Score Tracker">
            <Pane>
                <TabelloneController fx:id="table"/>
            </Pane>
        </Tab>
</TabPane>