        <mxCell id="QXbu02sNd9V-BZ-KgfqU-5" value="La partita inizia quando la avviene la chiamata Match.startMatch().&amp;nbsp;&lt;div&gt;Flow del match:&lt;/div&gt;&lt;div&gt;1- Il giocatore iniziale viene scelto in modo casuale&amp;nbsp;&lt;/div&gt;&lt;div&gt;2- Giocatore iniziale piazza la sua carta starter nel suo Field&amp;nbsp;&lt;/div&gt;&lt;div&gt;Ora comincia il loop del gioco&amp;nbsp;&lt;/div&gt;&lt;div&gt;3- Giocatore sceglie una carta dal suo mazzo&amp;nbsp;&lt;/div&gt;&lt;div&gt;4- Giocatore piazza la carta scelta nel suo Field&amp;nbsp;&lt;/div&gt;&lt;div&gt;5- Giocatore può scegliere di analizzare il suo Field, dando le coordinate dello slot che vuole analizzare&lt;/div&gt;&lt;div&gt;6- Quando giocatore decide di finire il suo turno si passa al Giocatore successivo&amp;nbsp;&lt;/div&gt;&lt;div&gt;Si torna al punto 2 se il Giocatore sta giocando per la prima volta, altrimenti si passa al punto 3 direttamente&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Ad ogni fine turno si fa il checkWinner() e si analizzano i punti del playingPlayer.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Se il playingPlayer ha raggiunto le condizioni di&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;vincita, si innesca la lastRoundRoutine() e si finisce l&#39;ultimo turno&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Si fa il checkTotalPoints() e successivamente si dichiara il vincitore.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2313" y="248" width="600" height="230" as="geometry" />
        </mxCell>
        <mxCell id="QXbu02sNd9V-BZ-KgfqU-6" value="When a player is&amp;nbsp;instantiated, playerDeck is generated from DrawingDeck.generatePlayerDeck().&amp;nbsp;&lt;div&gt;Takes randomly cards from totalCards&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="3190" y="-292" width="200" height="82" as="geometry" />
        </mxCell>
        <mxCell id="QXbu02sNd9V-BZ-KgfqU-7" value="resourceMana and elementsMana keep track of how many resources and elements the player sees in his field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="3220" y="-190" width="160" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
